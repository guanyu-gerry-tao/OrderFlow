#!/usr/bin/env bash
set -euo pipefail

MODE="improved"
REPEATED_SUBMIT_ATTEMPTS="${ORDERFLOW_BENCHMARK_REPEATED_SUBMIT_ATTEMPTS:-10000}"
CONCURRENT_ATTEMPTS="${ORDERFLOW_BENCHMARK_CONCURRENT_ATTEMPTS:-200}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      MODE="$2"
      shift 2
      ;;
    --repeated-submit-attempts)
      REPEATED_SUBMIT_ATTEMPTS="$2"
      shift 2
      ;;
    --concurrent-attempts)
      CONCURRENT_ATTEMPTS="$2"
      shift 2
      ;;
    --smoke)
      REPEATED_SUBMIT_ATTEMPTS="20"
      CONCURRENT_ATTEMPTS="25"
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

./gradlew benchmarkOrderCorrectness \
  -Pmode="${MODE}" \
  -PrepeatedSubmitAttempts="${REPEATED_SUBMIT_ATTEMPTS}" \
  -PconcurrentAttempts="${CONCURRENT_ATTEMPTS}" \
  --no-daemon
